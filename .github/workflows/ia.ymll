name: Baixando Lista

on:
  schedule:
    - cron: '*/50 * * * *'
  pull_request:
    branches:
      - main
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repositório
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Configurar Git
        run: |
          git config --global user.email "action@github.com"
          git config --global user.name "GitHub Action"

      - name: Deletar Log
        run: |
          rm -rf log.txt || echo "sem log"

      - name: Instalar dependências
        run: |
          python3 -m pip install --upgrade pip
          pip install streamlink selenium requests beautifulsoup4 lxml python-dateutil yt-dlp pytz

      - name: Verificar versão do Python
        run: python3 --version

      - name: Rodar script ia.py
        run: python3 ia.py

      - name: Verificar mudanças
        run: git status

      - name: Commit e Push
        run: |
          git add -A

          git diff --cached --quiet && echo "Nenhuma mudança" || (
            git commit -m "Atualizar lista baixada"
            git pull origin main --rebase || echo "Sem conflitos"
            git push origin main
          )
