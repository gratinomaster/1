name: Baixando Lista

on:
  schedule:
    - cron: '*/50 * * * *'  # Executa nos minutos 00 e 50 de cada hora
  pull_request:
    branches:
      - main
  workflow_dispatch:

# Permissões necessárias para o GitHub Action fazer push no repositório
permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    env:
      FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true # Resolve o aviso de depreciação do Node.js

    steps:
      - name: Checkout Repositório
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Configurar Git
        run: |
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git config --global user.name "github-actions[bot]"

      - name: Instalar dependências
        run: |
          python -m pip install --upgrade pip
          pip install beautifulsoup4 requests

      - name: Verificar e criar ia.txt (se não existir)
        id: check_ia_txt
        run: |
          if [ ! -f ia.txt ]; then
            echo "ia.txt não encontrado, criando arquivo padrão..."
            echo "https://archive.org/details/globo-e-record-novelas-e-variados-2005-2006-e-2010-fita-vhs" > ia.txt
            echo "https://archive.org/details/globo-tv-gazeta-sao-paulo-e-redetv-ano-2007-em-fita-vhs" >> ia.txt
            echo "ia_txt_created=true" >> $GITHUB_OUTPUT
          else
            echo "ia_txt_created=false" >> $GITHUB_OUTPUT
          fi

      - name: Rodar script ia2.py
        run: python3 ia2.py

      - name: Verificar arquivos gerados
        id: check_generated_files
        run: |
          if [ -f lista30.M3U ]; then
            echo "✓ lista30.M3U gerada com sucesso ($(wc -l < lista30.M3U  ) linhas)"
            echo "m3u_generated=true" >> $GITHUB_OUTPUT
          else
            echo "::error::Arquivo lista30.M3U não foi criado!"
            echo "m3u_generated=false" >> $GITHUB_OUTPUT
            exit 1
          fi

      - name: Commit e Push
        # Pull requests apenas testam o workflow; não fazem push para main.
        if: steps.check_generated_files.outputs.m3u_generated == 'true' && github.event_name != 'pull_request'
        run: |
          set -e

          # log.txt é um arquivo de diagnóstico e não faz parte do commit.
          # Restaura a versão do repositório ou remove-o se for não rastreado.
          if git ls-files --error-unmatch log.txt >/dev/null 2>&1; then
            git restore --source=HEAD --worktree -- log.txt
          else
            rm -f -- log.txt
          fi

          # Adiciona somente os arquivos de saída desejados.
          git add lista30.M3U

          # Adiciona ia.txt quando foi criado neste run ou quando o script o modificou.
          if [ "${{ steps.check_ia_txt.outputs.ia_txt_created }}" == "true" ] || ! git diff --quiet -- ia.txt; then
            git add ia.txt
          fi

          # Nenhum outro arquivo pode permanecer alterado.
          EXTRA_FILES=$(git status --porcelain \
            | sed -E 's/^.. //' \
            | grep -Ev '^(lista30\.M3U|ia\.txt)$' || true)

          if [ -n "$EXTRA_FILES" ]; then
            echo "::error::Arquivos inesperados foram alterados:"
            git status --short
            exit 1
          fi

          # Também não pode haver alteração não preparada para commit.
          if [ -n "$(git diff --name-only)" ]; then
            echo "::error::Ainda existem alterações fora do stage:"
            git status --short
            exit 1
          fi

          if git diff --cached --quiet; then
            echo "Nenhuma mudança detectada na lista ou em ia.txt. Nada para commitar."
            exit 0
          fi

          git commit -m "Atualização automática da playlist - $(date '+%Y-%m-%d %H:%M')"

          # Atualiza a branch local antes do push, preservando o commit recém-criado.
          git fetch origin main
          git rebase origin/main
          git push origin HEAD:main
