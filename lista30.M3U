    f.write("#EXTM3U\n")
    for (iid, fname), title in zip(entries, titles):
        url = base + iid + "/" + urllib.parse.quote(fname)
        f.write(f"#EXTINF:-1,{title}\n{url}\n")
print(open("/content/giofav_5_videos.m3u", encoding="utf-8").read())
EOF
